{
  "name": "merchantflare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test .test-dist/tests/decision-platform-integration.test.js",
    "test:integration:db": "tsc -p tsconfig.tools.json && node .tools-dist/scripts/verify-decision-database.js",
    "migrate": "tsc -p tsconfig.tools.json && node .tools-dist/scripts/migrate.js",
    "migrate:dry-run": "tsc -p tsconfig.tools.json && node .tools-dist/scripts/migrate.js --dry-run",
    "auth:bootstrap": "tsc -p tsconfig.tools.json && node .tools-dist/scripts/bootstrap-cognito-owner.js",
    "deployment:audit": "tsc -p tsconfig.tools.json && node .tools-dist/scripts/deployment-audit.js"
  },
  "dependencies": {
    "next": "latest",
    "postgres": "^3.4.7",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "6.0.2"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
