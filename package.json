{
  "name": "merchantflare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "migrate": "tsc -p tsconfig.tools.json && node .tools-dist/scripts/migrate.js",
    "migrate:dry-run": "tsc -p tsconfig.tools.json && node .tools-dist/scripts/migrate.js --dry-run"
  },
  "dependencies": {
    "next": "latest",
    "postgres": "^3.4.7",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "6.0.2"
  }
}
