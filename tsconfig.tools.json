{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "types": ["node"],
    "outDir": ".tools-dist",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", ".next", ".tools-dist"]
}
