{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": ".test-dist",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false
  },
  "include": [
    "tests/**/*.ts",
    "lib/auth.ts",
    "lib/idempotency.ts",
    "lib/mercury/**/*.ts",
    "lib/platform/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".test-dist"]
}
