# Application
# Production: https://app.merchantflare.com (the marketing apex remains separate)
APPLICATION_BASE_URL=http://localhost:3000
AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://user:password@localhost:5432/merchantflare

# Amazon Cognito (use the CloudFormation stack outputs)
COGNITO_AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_APP_CLIENT_ID=examplepublicclientid
COGNITO_ISSUER_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example
COGNITO_DOMAIN=https://merchantflare-example.auth.us-east-1.amazoncognito.com

# One-time administrative owner bootstrap (scripts only)
COGNITO_BOOTSTRAP_SUBJECT=00000000-0000-0000-0000-000000000000
COGNITO_BOOTSTRAP_EMAIL=owner@merchantflare.com
COGNITO_BOOTSTRAP_ORGANIZATION_ID=org_merchantflare
COGNITO_BOOTSTRAP_ORGANIZATION_NAME=MerchantFlare
COGNITO_BOOTSTRAP_ORGANIZATION_SLUG=merchantflare
